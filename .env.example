# Get an API key from Google AI Studio. Never put this key in VITE_* variables.
GEMINI_API_KEY=your_key_here

# Set these to model IDs enabled for your Google AI account.
# The names in the original product brief are preserved as defaults, but may not be
# available model IDs in your account/API version. Verify them in Google's model list.
GEMINI_ANALYSIS_MODEL=gemini-4-neon
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_JUDGE_MODEL=gemini-4-neon
PORT=8787
